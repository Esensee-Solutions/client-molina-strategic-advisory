---
/* Every page: <head>, header, footer and the behavior script. */
import '../styles/styles.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, localePath, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** The page's address without the language prefix: '', 'terms/' or 'privacy/'. */
  page: string;
  /** Where the page's title and description live: 'meta', 'meta.terms'… */
  metaPrefix: string;
  mainClass?: string;
}

const { lang, page, metaPrefix, mainClass } = Astro.props;
const t = useT(lang);
const origin = Astro.site!.origin;
const url = (l: Lang) => origin + localePath(l, page);
const ogLocale = { en: 'en_US', es: 'es_PR' } as const;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{t(`${metaPrefix}.title`)}</title>
<meta name="description" content={t(`${metaPrefix}.desc`)}>
<meta name="theme-color" content="#13243F">

<link rel="canonical" href={url(lang)}>
{languages.map((l) => <link rel="alternate" hreflang={l} href={url(l)}>)}
<link rel="alternate" hreflang="x-default" href={url('en')}>

<meta property="og:type" content="website">
<meta property="og:url" content={url(lang)}>
<meta property="og:title" content={t(`${metaPrefix}.title`)}>
<meta property="og:description" content={t(`${metaPrefix}.desc`)}>
<meta property="og:site_name" content="Molina Strategic Advisory">
<meta property="og:locale" content={ogLocale[lang]}>
{languages.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]}>)}
<meta property="og:image" content={`${origin}/assets/img/og-image.jpg`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Molina Strategic Advisory — People, Operations, Sales, Strategy">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/assets/img/logo-mark.png" type="image/png">
<link rel="apple-touch-icon" href="/assets/img/logo-mark.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

{lang === 'en' && (
  /* A visitor whose browser is in Spanish, arriving from another site, gets
     the Spanish page. Coming from this site (the EN link) keeps English. */
  <script is:inline data-lang-redirect define:vars={{ es: localePath('es', page) }}>
    try {
      var fromHere = document.referrer && new URL(document.referrer).origin === location.origin;
      if (!fromHere && /^es\b/i.test(navigator.language || '')) location.replace(es + location.hash);
    } catch (e) {}
  </script>
)}
</head>
<body>

<a class="skip-link" href="#main">{t('a11y.skip')}</a>

<Header lang={lang} page={page} />

<main id="main" class={mainClass}>
  <slot />
</main>

<Footer lang={lang} page={page} />

<script>
  import '../scripts/main.ts';
</script>
</body>
</html>
